{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "public/wasm/**",
    "tmp/**",
    "src/features/hyperframes-runtime/upstream/producer-node/**"
  ]
}
